---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---
<a class="skip-link" href="#main-content">跳转到正文</a>
<header class="site-header"><nav aria-label="主导航"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">∑</span>{SITE_TITLE}</a><div class="nav-links"><HeaderLink href="/">首页</HeaderLink><HeaderLink href="/blog">文章</HeaderLink><HeaderLink href="/about">关于</HeaderLink><a class="rss-link" href="/rss.xml">RSS ↗</a></div></nav></header>
<style>
.site-header{background:#fafbf8;border-bottom:1px solid var(--line)}nav{max-width:1120px;margin:auto;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:12px;color:var(--ink);font-weight:750;text-decoration:none;font-size:17px}.brand-mark{display:grid;place-items:center;background:var(--accent);color:white;border-radius:8px;width:32px;height:36px;font-family:Georgia,serif;font-size:25px}.nav-links{display:flex;gap:26px;align-items:center}.nav-links a{font-size:14px;text-decoration:none;color:var(--muted);padding:7px 0}.nav-links a.active{color:var(--accent);border-bottom:2px solid var(--accent)}@media(max-width:600px){nav{padding:16px;gap:12px}.brand{font-size:14px;gap:7px}.nav-links{gap:15px}.rss-link{display:none}.brand-mark{width:26px;height:30px}}
</style>
