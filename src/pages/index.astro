---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostList from '../components/PostList.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts.find((post) => post.id === 'mip-survey');
const chapters = featured ? (await render(featured)).headings.filter(h => h.depth === 1 && h.text.startsWith('第 ')) : [];
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main id="main-content" class="home-main">
      <section class="home-intro">
        <p class="eyebrow">PAPER NOTES / 学术与技术</p>
        <h1>把论文读懂，<br />把思路讲清。</h1>
        <p class="intro-copy">从直观理解到数学推导，从算法原理到可验证的例子。<br class="desktop-break" />记录机器学习与运筹优化的交汇，也记录每一步理解。</p>
        <div class="topic-tags"><span>机器学习</span><span>数学优化</span><span>论文精读</span></div>
      </section>
      {featured && <section class="featured-note" aria-labelledby="featured-title">
        <div class="featured-copy">
          <p class="eyebrow">精选笔记 / 01</p>
          <h2 id="featured-title">{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <span class="note-status">完整九章 · 8 张 SVG 图解 · 可下载笔记</span>
          <a class="read-button" href={`/blog/${featured.id}/`}>开始阅读 <span aria-hidden="true">→</span></a>
        </div>
        <a class="featured-figure" href={`/blog/${featured.id}/`} aria-label="阅读 MIP 学习笔记">
          <img src="/figures/lp-relaxation.svg" alt="LP 松弛的三角形可行域与混合整数可行线段" width="1200" height="760" />
          <span>FIG. 01 / 从连续可行域到混合整数决策</span>
        </a>
      </section>}
      <section class="chapter-section" aria-labelledby="chapter-title">
        <div class="section-heading"><div><p class="eyebrow">A GUIDED READING</p><h2 id="chapter-title">沿着问题，逐章深入</h2></div><span class="section-hint">从基础概念到学习型求解器</span></div>
        <div class="chapter-grid">{chapters.map((chapter, i) => <a class="chapter-card" href={`/blog/mip-survey/#${chapter.slug}`}><span class="chapter-number">{String(i + 1).padStart(2, '0')}</span><h3>{chapter.text.replace(/^第 \d+ 章\s*/, '')}</h3><span class="chapter-arrow" aria-hidden="true">↗</span></a>)}</div>
      </section>
      <section class="notes-section" aria-labelledby="notes-title">
        <div class="section-heading"><div><p class="eyebrow">READING LOG</p><h2 id="notes-title">文章与学习记录</h2></div><a href="/blog/">全部文章 →</a></div>
        <PostList posts={posts.filter(post => post.id === 'mip-survey')} />
        <details class="template-notes"><summary>模板示例与写作参考 · {posts.filter(post => post.id !== 'mip-survey').length} 篇</summary><PostList posts={posts.filter(post => post.id !== 'mip-survey')} /></details>
      </section>
    </main>
    <Footer />
  </body>
</html>
